# NicaScan lee variables del entorno del proceso. No carga .env automáticamente.
# Copia este archivo a tu shell: export $(grep -v '^#' .env | xargs)

# Ruta de la base SQLite portable (opcional)
# NICASCAN_DB=/ruta/a/negocios.db

# User-Agent con contacto, obligatorio para Nominatim/Overpass
NICASCAN_USER_AGENT=nicascan/0.1.0 (+https://github.com/xozan845-ctrl/nicascan)

# Puedes cambiar los espejos de Overpass (separados por coma)
# NICASCAN_OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# NICASCAN_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Fuentes opcionales de pago / con cuota
# GOOGLE_PLACES_API_KEY=
# FOURSQUARE_API_KEY=

# Idioma de las consultas y respuestas de proveedores
NICASCAN_LANGUAGE=es

# Evita llamadas de red (usa solo la caché y datos locales)
# NICASCAN_OFFLINE=1
