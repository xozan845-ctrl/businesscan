# BusinessCan lee variables del entorno del proceso. No carga .env automáticamente.
# Copia este archivo a tu shell: export $(grep -v '^#' .env | xargs)

# Ruta de la base SQLite portable (opcional)
# BUSINESSCAN_DB=/ruta/a/negocios.db

# User-Agent con contacto, obligatorio para Nominatim/Overpass
BUSINESSCAN_USER_AGENT=businesscan/0.1.0 (+https://github.com/xozan845-ctrl/businesscan)

# Puedes cambiar los espejos de Overpass (separados por coma)
# BUSINESSCAN_OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# BUSINESSCAN_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Fuentes opcionales de pago / con cuota
# GOOGLE_PLACES_API_KEY=
# FOURSQUARE_API_KEY=

# Overture Maps: archivo local opcional (por defecto usa PMTiles automático)
# BUSINESSCAN_OVERTURE_FILE=/ruta/overture-managua.geojson

# Idioma de las consultas y respuestas de proveedores
BUSINESSCAN_LANG=es

# Evita llamadas de red (usa solo la caché y datos locales)
# BUSINESSCAN_OFFLINE=1

# Enriquecimiento web: pausa mínima por host (ms)
# BUSINESSCAN_ENRICH_DELAY_MS=2000

# API local: token Bearer para `businesscan serve`
# BUSINESSCAN_API_TOKEN=
